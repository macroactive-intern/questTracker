                  "key": "sort",
                  "value": "due_at_asc"
                },
                {
                  "key": "search",
                  "value": "dragon"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('list returns data, meta, and links', function () {",
                  "  pm.expect(json).to.have.property('data').that.is.an('array');",
                  "  pm.expect(json).to.have.property('meta');",
                  "  pm.expect(json).to.have.property('links');",
                  "});"
                ]
              }
            }
